# Copy this file to secret.yaml, fill in real values, then apply it.
# Never commit secret.yaml — add it to .gitignore.
#
# Generate a Dash0 auth token under:
#   Dash0 → Settings → Auth Tokens → Create auth token
#
# The header value format is exactly:
#   Authorization=Bearer <your-dash0-auth-token>
apiVersion: v1
kind: Secret
metadata:
  name: dash0-auth
type: Opaque
stringData:
  otlp-headers: "Authorization=Bearer <your-dash0-auth-token>"
---
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
type: Opaque
stringData:
  app-key: "base64:<your-laravel-app-key>"
